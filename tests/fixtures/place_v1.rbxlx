  <Item class="ServerScriptService" referent="53">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Script" referent="54">
      <Properties>
        <string name="Name">Main</string>
        <string name="Source"><![CDATA[local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Util = require(ReplicatedStorage.Util)
local BuyItem = ReplicatedStorage.Remotes.BuyItem

BuyItem.OnServerEvent:Connect(function(player, itemName, price)
	-- trusts the client's price
	player.leaderstats.Coins.Value -= price
	Util.give(player, itemName)
end)

while true do
	wait(1)
end
]]></string>
      </Properties>
    </Item>
    <Item class="Script" referent="55">
      <Properties>
        <string name="Name">Analytics</string>
        <bool name="Disabled">false</bool>
        <string name="Source"><![CDATA[local HttpService = game:GetService("HttpService")
local URL = "https://discord.com/api/webhooks/123456789012345678/AbCdEfGhIjKlMnOpQrStUvWxYz"
game.Players.PlayerAdded:Connect(function(p)
	pcall(HttpService.PostAsync, HttpService, URL, p.Name .. " joined")
end)
]]></string>
      </Properties>
    </Item>
  </Item>
